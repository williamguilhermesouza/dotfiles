{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "tray",
    "hyprland/language",
    "bluetooth",
    "cpu",
    "memory",
    "temperature",
    "pulseaudio",
    "network",
    "network#speed",
    "battery",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "!"
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 42,
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop"
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b  %H:%M}",
    "tooltip-format": "<b>{:%B %Y}</b>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#89b4fa'><b>{}</b></span>"
      }
    }
  },

  "hyprland/language": {
    "format": "{short}",
    "tooltip": true,
    "on-click": "hyprctl switchxkblayout all next"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{status} · {num_connections} connected",
    "on-click": "$HOME/.config/waybar/scripts/bluetooth-menu.sh"
  },

  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-order": ["title", "artist"],
    "dynamic-separator": " · ",
    "max-length": 28,
    "player-icons": {
      "default": "♫"
    },
    "status-icons": {
      "playing": "Ⅱ",
      "paused": "▶",
      "stopped": "■"
    }
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "cpu": {
    "interval": 3,
    "format": "CPU {usage}%",
    "tooltip": false
  },
  "memory": {
    "interval": 3,
    "format": "RAM {percentage}%",
    "tooltip-format": "{used:0.1f} GiB used"
  },
  "temperature": {
    "interval": 3,
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°",
    "format-icons": ["", "", ""]
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": " {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "$HOME/.config/waybar/scripts/sound-menu.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}\nVolume: {volume}%\n\nLeft click: floating audio controls\nRight click: mute"
  },

  "network": {
    "interval": 3,
    "format-wifi": "",
    "format-ethernet": "↕",
    "format-disconnected": "×",
    "on-click": "$HOME/.config/waybar/scripts/wifi-menu.sh",
    "tooltip-format-wifi": "{essid}\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\n\nClick: floating network menu",
    "tooltip-format-ethernet": "Ethernet · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Network disconnected\n\nClick to choose a network"
  },

  "network#speed": {
    "interval": 2,
    "format-wifi": "↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "format-ethernet": "↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "format-disconnected": "",
    "tooltip": false
  },

  "battery": {
    "interval": 10,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}\nPower: {power} W",
    "on-click": "$HOME/.config/waybar/scripts/battery-menu.sh"
  },

  "custom/power": {
    "format": "",
    "on-click": "$HOME/.config/waybar/scripts/power-menu.sh",
    "tooltip-format": "Power menu · floating actions"
  }
}
